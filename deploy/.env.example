# /opt/leuva-lagna/.env  (chmod 600; install.sh fills in ADMIN_PASSWORD)

# The admin password: only the admin can create groups and delete things
# forever. At least 12 characters; install.sh generates a random one.
ADMIN_PASSWORD=CHANGE_ME

# 1 = anyone may create a group (they become its owner). 0 = only the admin.
OPEN_CREATE=0

# Port on the Pi (127.0.0.1 only). install.sh sets it; Caddy's reverse_proxy must match.
# APP_PORT=8200

# Public address. Needed for MCP sign-in (OAuth) from claude.ai; also used in messages.
PUBLIC_URL=https://leuva-lagna.duckdns.org

# MCP sign-in: apps allowed to connect (where they return to) and localhost for Claude Code.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
# OAUTH_ALLOW_LOOPBACK=1

# Backups (backup.sh): encrypt to this age public key (age1...), keep N copies.
# AGE_RECIPIENT=
BACKUP_KEEP=14

# Cosign image used to check signatures when cosign isn't installed on the Pi.
# COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.4.1
